# Copy this file to '.env' and fill in your configuration options.
# Uses the same self-hosted ntfy broker as the botc grimoire-companion app
# (ntfy.brodin.rocks), but a distinct topic prefix (brodin-games-<code>)
# to avoid colliding with that app's botc-companion-<code> topics.
EMAIL=
DOMAIN=

VITE_NTFY_SERVER_URL=ntfy.brodin.rocks
VITE_NTFY_ADMIN_USERNAME=
VITE_NTFY_ADMIN_PASSWORD=

# Optional: per-app overrides, namespaced by app so future games can define
# their own without colliding with this one.

# Memo-Random: shorten round/timer lengths for faster manual testing (all in
# milliseconds). Leave unset to use the normal game-length defaults
# (60s / 60s / 20s vote / 10s results / 15s grace). Uncomment and lower
# these while testing:
# VITE_MEMORANDOM_ROUND1_DURATION_MS=10000
# VITE_MEMORANDOM_ROUND2_DURATION_MS=10000
# VITE_MEMORANDOM_VOTE_DURATION_MS=8000
# VITE_MEMORANDOM_RESULTS_DURATION_MS=5000
# VITE_MEMORANDOM_GRACE_PERIOD_MS=5000

# Memo-Random: cap how many players can join a single room. Leave unset for
# the default of 12.
# VITE_MEMORANDOM_MAX_PLAYERS=12

# Optional: enables dev-only UI, like the Round 1 "FILL" button that
# auto-fills your word list. Leave unset/false for normal play.
# VITE_DEBUG=true
